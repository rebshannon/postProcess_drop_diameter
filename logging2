BASH_FUNC_wait_until_port_used%%=() {  local port="${1}";
 local time="${2:-30}";
 for ((i=1; i<=time*2; i++))
 do
 port_used "${port}";
 port_status=$?;
 if [ "$port_status" == "0" ]; then
 return 0;
 else
 if [ "$port_status" == "127" ]; then
 echo "commands to find port were either not found or inaccessible.";
