BASH_FUNC_find_port%%=() {  local host="${1:-localhost}";
 local min_port=${2:-2000};
 local max_port=${3:-65535};
 local port_range=($(shuf -i ${min_port}-${max_port}));
 local retries=1;
 for ((attempt=0; attempt<=$retries; attempt++))
 do
 for port in "${port_range[@]}";
 do
 if port_used "${host}:${port}"; then
 continue;
 fi;
 echo "${port}";
 return 0;
 done;
 done;
 echo "error: failed to find available port in range ${min_port}..${max_port}" 1>&2;
 return 1
}
